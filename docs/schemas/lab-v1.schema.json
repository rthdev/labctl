{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labctl.invalid/schemas/lab-v1.schema.json",
  "title": "labctl lab definition schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "goal", "instructions", "provider", "grader", "vms"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Z]{2}[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "instructions": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "grader": {"type": "string"},
    "grading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reset_vms"],
      "properties": {
        "reset_vms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
        }
      }
    },
    "controller_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller", "targets"],
      "properties": {
        "controller": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "targets": {
          "type": "object", "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"},
          "additionalProperties": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "not": {"enum": ["all", "ungrouped"]}}
          }
        }
      }
    },
    "vms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "cpus", "ram", "disk", "image", "hostname", "interfaces", "setup", "depends_on"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "cpus": {"type": "integer", "minimum": 1},
          "ram": {"type": "string", "pattern": "^[1-9][0-9]*(KiB|MiB|GiB|TiB)$"},
          "disk": {"type": "string", "pattern": "^[1-9][0-9]*(KiB|MiB|GiB|TiB)$"},
          "image": {"type": "string", "minLength": 1},
          "hostname": {"type": "string", "minLength": 1},
          "interfaces": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {"type": {"const": "isolated_nat"}}
            }
          },
          "setup": {"type": "string"},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "ssh_user": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
